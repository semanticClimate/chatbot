# Copy to slack.env (gitignored) and fill in values from your Slack app.
# Create app: https://api.slack.com/apps → OAuth scopes: files:write, chat:write
# Install to workspace, invite bot to channel, copy bot token (xoxb-...).

SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0123456789

# Upload every file in each Zoom session folder (1=yes, 0=summary+transcript only)
ZOOM_SLACK_UPLOAD_ALL_SESSION_FILES=1
# HTTP timeout for large video uploads (seconds)
ZOOM_SLACK_TIMEOUT_S=600
