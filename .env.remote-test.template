# Copy this file to .env.remote-test (do not commit .env.remote-test)
# then edit values for your Cloudflare hostnames and API key.

export GROQ_API_KEY='REPLACE_WITH_REAL_KEY'

# Browser origin(s) that are allowed to call your API.
# Usually this is your public UI URL.
# Comma-separate if you have multiple origins.
export CLIMATE_API_CORS_ORIGINS='https://chat.example.com'

# Friendly URL printed by scripts/start_remote_test.sh.
# This should be the URL that M/J open in their browser.
export CLIMATE_PUBLIC_CHAT_URL='https://chat.example.com'
